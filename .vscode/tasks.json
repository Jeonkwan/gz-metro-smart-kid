{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Metro Explorer Server",
      "type": "shell",
      "command": "python3",
      "args": ["-m", "http.server", "8000"],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Serving HTTP on",
          "endsPattern": "Serving HTTP on"
        }
      }
    }
  ]
}