# =============================================================
# gz-metro-smart-kid — container environment variables
# =============================================================
#
# DEPLOY_MODE   http  → plain HTTP, no TLS  (default, safe for localhost)
#               https → automatic TLS via Let's Encrypt ACME HTTP-01
#
# HTTP_PORT     Port to listen on in http mode    (default: 8080)
# SITE_HOST     Public hostname for https mode    (required in https mode)
# HTTPS_PORT    HTTPS listen port                 (default: 8443)
# ACME_EMAIL    Email for Let's Encrypt registration (required in https mode)
# =============================================================

# --- Local / development HTTP ---
DEPLOY_MODE=http
HTTP_PORT=8080

# --- Production HTTPS (uncomment and fill in) ---
# DEPLOY_MODE=https
# SITE_HOST=gzmetro.mokamaker.space
# HTTPS_PORT=8443
# ACME_EMAIL=jeonkwan@gmail.com
